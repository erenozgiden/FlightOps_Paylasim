{
  // Veritabanı seçimi
  //   "Sqlite" : kurulum gerektirmez (varsayılan). Veritabanı dosyası: %LOCALAPPDATA%\FlightOps\flightops.db
  //   "MySql"  : önce Veritabani/flightops_mysql.sql dosyasını MySQL'e içe aktarın,
  //              sonra aşağıdaki bağlantı bilgilerini kendi MySQL sunucunuza göre düzenleyin.
  //              (XAMPP varsayılanı: kullanıcı root, şifre boş, port 3306)
  "Veritabani": {
    "Tur": "Sqlite",
    "MySqlBaglanti": "Server=localhost;Port=3306;Database=flightops;User=root;Password=;"
  },

  "Uygulama": {
    // Uygulama açılınca tarayıcı kendiliğinden açılsın mı
    "TarayiciyiAc": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
